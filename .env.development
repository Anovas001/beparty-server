NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://beparty:beparty@localhost:5432/beparty?schema=public

# Security
JWT_SECRET=dev-jwt-secret-not-for-production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# PgAdmin (optional)
PGADMIN_DEFAULT_EMAIL=admin@beparty.local
PGADMIN_DEFAULT_PASSWORD=admin